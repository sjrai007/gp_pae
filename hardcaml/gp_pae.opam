# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis:
  "GP_PAE: a general-purpose protocol emulator ASIC, generated in Hardcaml"
description:
  "Hardcaml source of truth for GP_PAE, a reprogrammable protocol emulator chip: a tiny CPU whose instruction set reads pins, writes pins and counts cycles, replicated into independent lanes so UART, SPI and I2C run concurrently and new protocols can be loaded after fabrication. Generates the Verilog hardened by the Tiny Tapeout flow."
maintainer: ["Suresh Rai"]
authors: ["Suresh Rai"]
license: "Apache-2.0"
homepage: "https://github.com/sjrai007/gp_pae"
bug-reports: "https://github.com/sjrai007/gp_pae/issues"
depends: [
  "ocaml" {>= "5.0"}
  "dune" {>= "3.0"}
  "hardcaml"
  "hardcaml_waveterm"
  "ppx_hardcaml"
  "core"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/sjrai007/gp_pae.git"
